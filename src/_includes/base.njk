<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>macik.xyz</title>
  <meta name="theme-color" content="#245edb">

  <link rel="icon" href="/images/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="stylesheet" href="https://unpkg.com/xp.css@0.2.6/dist/XP.css">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/agents/clippy.css">
</head>
<body>

  <div id="bg-grid" aria-hidden="true"></div>

  <div class="screen-wrapper">
    <div class="layout-grid">

      <aside class="sidebar-col">
        <div class="window">
          <div class="title-bar"><div class="title-bar-text">profile</div></div>
          <div class="window-body profile">
            <img src="/icons/user-accounts.png" class="avatar-img" alt="Me" width="64" height="64">
            <dl class="profile-facts">
              <dt>User:</dt><dd>???</dd>
              <dt>Loc:</dt><dd>???</dd>
              <dt>Status:</dt><dd><span class="status-dot"></span> Online</dd>
            </dl>
            <div class="now-playing" title="Now playing">
              <img src="/icons/my-music.png" class="tree-icon" alt="">
              <div class="now-playing-track"><span>Rick Astley - Never Gonna Give You Up</span></div>
            </div>
          </div>
        </div>

        <nav class="window" aria-label="Pages">
          <div class="title-bar"><div class="title-bar-text">Explorer</div></div>
          <div class="window-body explorer">
            <ul class="tree-view">
              <li><a href="#home" data-nav="home"><img src="/icons/desktop.png" class="tree-icon" alt=""> Desktop</a></li>
              <li><a href="#interests" data-nav="interests"><img src="/icons/my-pictures.png" class="tree-icon" alt=""> My Pictures</a></li>
              <li><a href="#hardware" data-nav="hardware"><img src="/icons/system-properties.png" class="tree-icon" alt=""> Device Manager</a></li>
              <li><a href="#contact" data-nav="contact"><img src="/icons/entire-network.png" class="tree-icon" alt=""> Network Places</a></li>
              <li><a href="mailto:macik@macik.xyz"><img src="/icons/email.png" class="tree-icon" alt=""> Outlook Express</a></li>
            </ul>
          </div>
        </nav>
      </aside>

      <main class="main-col">
        <div class="window ie-window" id="ie-window">
          <div class="title-bar">
            <div class="title-bar-text">
              <img src="/icons/internet-explorer-6.png" class="tree-icon" alt="">
              Microsoft Internet Explorer
            </div>
            <div class="title-bar-controls">
              <button aria-label="Minimize" data-win="minimize"></button>
              <button aria-label="Maximize" data-win="maximize"></button>
              <button aria-label="Close" data-win="close"></button>
            </div>
          </div>

          <form class="window-body ie-toolbar" id="address-form">
            <button type="button" id="btn-back" class="toolbar-btn" disabled>
              <img src="/icons/back.png" class="toolbar-icon" alt=""> <span>Back</span>
            </button>
            <button type="button" id="btn-fwd" class="toolbar-btn" disabled>
              <img src="/icons/forward.png" class="toolbar-icon" alt=""> <span>Forward</span>
            </button>

            <div class="toolbar-sep"></div>
            <label for="address-bar" class="address-label">Address</label>

            <div class="address-container">
              <img src="/icons/internet-explorer-6.png" alt="">
              <input type="text" id="address-bar" class="address-input" value="https://malchik.xyz/home" spellcheck="false" autocomplete="off">
            </div>

            <button type="submit" class="toolbar-btn">
              <img src="/icons/go.png" class="toolbar-icon" alt=""> <span>Go</span>
            </button>
          </form>

          <nav class="links-bar" aria-label="Pages">
            <span class="links-label">Links</span>
            <a href="#home" data-nav="home">Home</a>
            <a href="#interests" data-nav="interests">Interests</a>
            <a href="#hardware" data-nav="hardware">Hardware</a>
            <a href="#contact" data-nav="contact">Contact</a>
          </nav>

          <div class="window-body content-scroll" id="content">
            {{ content | safe }}
          </div>

          <div class="status-bar">
            <p class="status-bar-field" id="status-text">Done</p>
            <p class="status-bar-field status-zone">
              <img src="/icons/entire-network.png" class="tree-icon" alt=""> Internet
            </p>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Start menu -->
  <div class="start-menu" id="start-menu" hidden>
    <div class="start-menu-header">
      <img src="/images/lain.webp" alt="" width="40" height="40">
      <strong>malchik</strong>
    </div>
    <div class="start-menu-body">
      <ul class="start-menu-left">
        <li><a href="#home" data-nav="home"><img src="/icons/desktop.png" alt=""> Desktop</a></li>
        <li><a href="#interests" data-nav="interests"><img src="/icons/my-pictures.png" alt=""> My Pictures</a></li>
        <li><a href="#hardware" data-nav="hardware"><img src="/icons/system-properties.png" alt=""> Device Manager</a></li>
        <li><a href="#contact" data-nav="contact"><img src="/icons/entire-network.png" alt=""> Network Places</a></li>
      </ul>
      <ul class="start-menu-right">
        <li><a href="mailto:macik@macik.xyz"><img src="/icons/email.png" alt=""> E-mail me</a></li>
        <li><button type="button" data-agent="summon"><img src="/icons/remote-assistance.png" alt=""> Summon an assistant</button></li>
        <li><button type="button" data-agent="dismiss"><img src="/icons/help-and-support.png" alt=""> Dismiss assistants</button></li>
      </ul>
    </div>
    <div class="start-menu-footer">
      <button type="button" id="btn-shutdown"><img src="/icons/logout.png" alt=""> Turn Off Computer</button>
    </div>
  </div>

  <!-- Taskbar -->
  <footer class="taskbar">
    <button type="button" class="start-button" id="start-button" aria-expanded="false" aria-controls="start-menu">
      <span class="start-flag" aria-hidden="true"><i></i><i></i><i></i><i></i></span>start
    </button>
    <button type="button" class="task-button active" id="task-ie">
      <img src="/icons/internet-explorer-6.png" alt=""> <span>Microsoft Internet Explorer</span>
    </button>
    <div class="tray">
      <img src="/icons/volume.png" alt="">
      <time id="clock"></time>
    </div>
  </footer>

  <div class="shutdown-screen" id="shutdown-screen" hidden>
    <p>It is now safe to turn off your computer.</p>
    <small>(click anywhere to turn it back on)</small>
  </div>

  <script src="/js/vendor/jquery.min.js" defer></script>
  <script src="/js/vendor/clippy.js" defer></script>
  <script src="/js/site.js" defer></script>
</body>
</html>
